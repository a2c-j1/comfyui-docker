services:
  comfyui:
    image: ghcr.io/a2c-j1/comfyui:latest
    build: .
    container_name: comfyui
    restart: unless-stopped

    ports:
      - "8188:8188"

    gpus: all

    environment:
      - TLS_KEYFILE=/app/ComfyUI/certs/key.pem
      - TLS_CERTFILE=/app/ComfyUI/certs/cert.pem
      # - CUDA_VISIBLE_DEVICES=0

    volumes:
      - ${COMFYUI_DATA_DIR:-./data}/custom_nodes:/app/ComfyUI/custom_nodes
      - ${COMFYUI_DATA_DIR:-./data}/user:/app/ComfyUI/user
      - ${COMFYUI_DATA_DIR:-./data}/models:/app/ComfyUI/models
      - ${COMFYUI_DATA_DIR:-./data}/input:/app/ComfyUI/input
      - ${COMFYUI_DATA_DIR:-./data}/output:/app/ComfyUI/output
      - ${COMFYUI_DATA_DIR:-./data}/__manager:/app/ComfyUI/user/__manager
      - ./certs:/app/ComfyUI/certs

    # Swarm-only GPU reservation; ignored by docker compose.
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
